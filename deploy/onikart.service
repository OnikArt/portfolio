[Unit]
Description=OnikArt production service
After=network.target

[Service]
Type=simple
User=onikart
WorkingDirectory=/opt/onikart/current
EnvironmentFile=/etc/onikart/onikart.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
